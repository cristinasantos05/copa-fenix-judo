generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id    String @id
  email String  @unique
  name  String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cups Cup[]
} 

model Cup {
  id Int @id @default(autoincrement())
  name String
  startDate DateTime
  endDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams Team[] 
  judoClubs JudoClub[]
  brackets Bracket[]
  userId String
  user User @relation(fields: [userId], references: [id])
}

model JudoClub {
  id Int @id @default(autoincrement())
  name String
  cups Cup[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id Int @id @default(autoincrement())
  name String
  gender String
  cups Cup[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  athletes Athlete[]
  brackets Bracket[]
}

model Athlete {
  id Int @id @default(autoincrement())
  name String
  age Int
  weight Float
  teamId Int
  team Team @relation(fields: [teamId], references: [id])
  lineUps LineUp[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bracket{
  id Int @id @default(autoincrement())
  teams Team[]
  cupId Int
  cup Cup @relation(fields: [cupId], references: [id])
  lineUps LineUp[]
}

model LineUp {
  id Int @id @default(autoincrement())
  athletes Athlete[]
  bracketId Int
  bracket Bracket @relation(fields: [bracketId], references: [id])
}